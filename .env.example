# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API Keys). Sem essas variáveis, os votos ficam só no navegador.
# Use a chave "publishable" (ou "anon"), NUNCA a "secret" / "service_role".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
